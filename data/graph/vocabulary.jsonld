   },
   "skos:prefLabel": "renamed as",
   "skos:definition": "an organisation is the same organisation under a later name, as a document states"
  },
  {
   "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relation/ships_to",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relations"
   },
   "skos:prefLabel": "ships to",
   "skos:definition": "goods move from one country or port to another (customs statistics)"
  },
  {
   "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relation/supplies_fuel_to",
