   "skos:inScheme": {
    "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relations"
   },
   "skos:prefLabel": "read again",
   "skos:definition": "a check of the ledger read this document again (it is named in the check's findings)"
  },
  {
   "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relation/read_from",
   "@type": "skos:Concept",
   "skos:inScheme": {
