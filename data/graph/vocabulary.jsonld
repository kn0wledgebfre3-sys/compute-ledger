   "skos:inScheme": {
    "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relations"
   },
   "skos:prefLabel": "supplies fuel to",
   "skos:definition": "a pipeline or supplier delivers fuel to a site's generation"
  },
  {
   "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relation/supplies_memory_to",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relations"
   },
   "skos:prefLabel": "supplies memory to",
   "skos:definition": "a memory maker supplies memory to a chip or system maker"
  },
  {
   "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relation/supplies_power_to",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relations"
   },
   "skos:prefLabel": "supplies power to",
   "skos:definition": "a plant, utility or grid supplies electricity to a site or cluster"
  },
  {
   "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relation/supplies_water_to",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relations"
   },
   "skos:prefLabel": "supplies water to",
   "skos:definition": "a utility or source supplies water to a site"
  },
  {
   "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#bases",
   "@type": "skos:ConceptScheme",
   "skos:prefLabel": "bases"
  },
  {
   "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#basis/assured_disclosure",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#bases"
   },
   "skos:prefLabel": "assured disclosure",
   "skos:definition": "a company-reported figure covered by a third-party assurance statement; cite the statement and give its level (limited or reasonable) in notes"
  },
  {
   "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#basis/audit_or_court",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#bases"
   },
   "skos:prefLabel": "audit or court",
   "skos:definition": "an auditor's or court's finding"
  },
  {
   "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#basis/company_statement",
