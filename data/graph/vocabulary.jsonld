   },
   "skos:prefLabel": "packages for",
   "skos:definition": "an assembly, test and packaging house (OSAT), or a packaging joint venture, packages and tests chips for a chip designer"
  },
  {
   "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relation/published_by",
