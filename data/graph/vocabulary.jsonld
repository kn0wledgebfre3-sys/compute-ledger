  },
  {
   "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relation/operates",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relations"
   },
   "skos:prefLabel": "operates",
   "skos:definition": "an entity operates a site"
  },
  {
