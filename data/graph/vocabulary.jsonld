   },
   "skos:prefLabel": "derived",
   "skos:definition": "computed by the ledger from other rows (formula in metric_detail)"
  },
  {
   "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#basis/estimate_by_record_holder",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#bases"
   },
   "skos:prefLabel": "estimate by record holder",
   "skos:definition": "an estimate made by the public body that published it (e.g., a market monitor's counterfactual)"
  },
  {
   "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#basis/filed",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#bases"
   },
   "skos:prefLabel": "filed",
   "skos:definition": "a figure a utility or operator filed with a regulator or grid operator (demand, forecast, contract)"
  },
  {
   "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#basis/government_document",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#bases"
   },
   "skos:prefLabel": "government document",
   "skos:definition": "a statement of fact in a government agency's own document that is not a decision, a statistic or an estimate (for example an environmental assessment describing existing infrastructure)"
  },
  {
   "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#basis/inventory",
