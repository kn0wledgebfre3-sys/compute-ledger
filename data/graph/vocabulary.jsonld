    "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relations"
   },
   "skos:prefLabel": "mines for",
   "skos:definition": "a mine or mining company supplies ore or concentrate to a smelter or refiner"
  },
  {
   "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relation/names",
