  },
  {
   "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relation/assembles_for",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relations"
   },
   "skos:prefLabel": "assembles for",
   "skos:definition": "an assembler or contract manufacturer builds boards, systems or servers for a buyer"
  },
  {
   "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relation/based_in",
   "@type": "skos:Concept",
   "skos:inScheme": {
