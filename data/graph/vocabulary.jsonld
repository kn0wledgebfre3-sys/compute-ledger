   "skos:inScheme": {
    "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relations"
   },
   "skos:prefLabel": "cites",
   "skos:definition": "a ledger entry cites this document, on its record side or its claim side",
   "skos:closeMatch": {
    "@id": "schema:citation"
   }
  },
