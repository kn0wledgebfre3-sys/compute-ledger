    "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relations"
   },
   "skos:prefLabel": "examined",
   "skos:definition": "a check of the ledger examined this site, organisation or entry"
  },
  {
   "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relation/fabricates_for",
   "@type": "skos:Concept",
   "skos:inScheme": {
    "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relations"
   },
   "skos:prefLabel": "fabricates for",
   "skos:definition": "a foundry makes chips for a chip designer or buyer"
  },
  {
   "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#relation/hosts_compute_for",
