   "skos:inScheme": {
    "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#bases"
   },
   "skos:prefLabel": "company statement",
   "skos:definition": "a party's statement in its own voice: a company's or industry body's release, report, plan or filing narrative, or a government's announcement, plan, forecast or target (as opposed to its binding decisions, statistics and gazetted rules)"
  },
  {
   "@id": "https://kn0wledgebfre3-sys.github.io/compute-ledger/vocab#basis/derived",
   "@type": "skos:Concept",
   "skos:inScheme": {
